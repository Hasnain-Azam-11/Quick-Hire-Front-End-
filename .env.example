# Base URL for the Django API.
# Leave unset in development: requests go to /backend, which Vite proxies to http://127.0.0.1:8000
# (see vite.config.js), so no CORS configuration is needed.
# For a deployed build, set the real API URL (the backend must then allow this site via CORS):
# VITE_API_BASE_URL=https://api.example.com

# Point the dev proxy at a different backend (for example a scratch copy on another port):
# BACKEND_URL=http://127.0.0.1:8011 npm run dev
